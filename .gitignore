__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# Blender artifacts
*.blend1
*.blend2

# Patient identity must never enter the repository.
# The case_id -> real identity mapping stays local, always.
case_map.json
case_map.csv
private/

# Full-resolution patient meshes are too large to version and are not
# needed for tests; only coarse fixtures and landmark files are committed.
data/cases/**/*.stl
!tests/fixtures/**/*.stl

# The implant library is a separate design output, not source. The launcher picks it
# up from here when it exists, so a folder or a junction called data/implants makes
# one double-click work without setting anything.
data/implants/

# Pipeline outputs
Output/
*.log

# CLI output directories
demo_out/
cohort_out/
out/
tka_planner.zip
tka_planner_v*.zip

# Vendored wheels: binary, platform-specific, rebuilt with vendor/README.md
vendor/*
!vendor/README.md
