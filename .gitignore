__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# Blender artifacts
*.blend1
*.blend2

# Patient identity must never enter the repository.
# The case_id -> real identity mapping stays local, always.
case_map.json
case_map.csv
private/

# Full-resolution patient meshes are too large to version and are not
# needed for tests; only coarse fixtures and landmark files are committed.
data/cases/**/*.stl
!tests/fixtures/**/*.stl

# The implant catalogue is committed in data/implants/ (all twelve sizes, without the
# bones exported with them), mirrored from the export by tools/publish_eval.py. The
# launcher picks it up from there, so one double-click works without setting anything.

# Pipeline outputs
Output/
*.log

# CLI output directories
demo_out/
cohort_out/
out/
tka_planner.zip
tka_planner_v*.zip

# Vendored wheels: binary, platform-specific, rebuilt with vendor/README.md
vendor/*
!vendor/README.md

# Fusion CAD sources and parameter exports: design IP and the reference bone. Never public.
fusion/Fusion files/
fusion/Parameter-Export/
# Patient scans. Folder names carry identities: never public.
Patient Dataset/
# Planning, specs and design documents stay private (the repo is public).
docs/Prep for paper/
docs/superpowers/

# Plan-execution scratch (ledgers, review packages).
.superpowers/

# Media: videos are too large for GitHub and stay local; images are committed.
media/*.mp4
# Development report and its formatting spec and assets stay local.
docs/Отчёт_о_разработке_планировщика_ТЭКС.md
docs/Report-formatting.txt
docs/report_assets/
